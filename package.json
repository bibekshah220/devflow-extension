{
  "name": "devflow-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered developer productivity and debugging Chrome extension",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @devflow/shared && npm run build -w @devflow/extension",
    "typecheck": "tsc --build && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "clean": "tsc --build --clean && rm -rf packages/*/dist",
    "dev": "npm run dev -w @devflow/extension"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
