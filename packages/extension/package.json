{
  "name": "@devflow/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevFlow AI Chrome extension (Manifest V3)",
  "scripts": {
    "dev": "npm run build -- --watch",
    "build": "vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:e2e": "node e2e/smoke.mjs",
    "package": "npm run build && rm -f devflow-ai-$npm_package_version.zip && cd dist && zip -qr ../devflow-ai-$npm_package_version.zip . -x '*.map'"
  },
  "dependencies": {
    "@devflow/shared": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.300",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
