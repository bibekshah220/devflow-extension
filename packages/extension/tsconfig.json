{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["chrome", "vite/client", "node"],

    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,

    "paths": {
      "@devflow/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.config.ts"]
}
